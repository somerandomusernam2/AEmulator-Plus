<resources>
    <string name="vs_hide_menu">隐藏菜单按钮</string>
    <string name="vs_hide_menu_sub">隐藏 … 按钮。手机的返回键或返回手势将打开模拟器菜单，而不是向 Android 发送返回。客户机的导航按钮仍可控制 Android。</string>
    <string name="vs_vibration">客户机振动</string>
    <string name="vs_vibration_sub">将旧版客户机的振动转发到手机。下次启动时生效；每次振动最长限制为 60 秒。</string>
    <string name="nav_buttons">导航按钮</string>
    <string name="nav_order">按钮顺序（从左到右）</string>
    <string name="nav_earlier">前移</string>
    <string name="nav_later">后移</string>
    <string name="nav_reset">重置按钮</string>
    <string name="nav_search">搜索</string>
    <string name="nav_power">电源</string>
    <string name="nav_volume_down">音量减</string>
    <string name="nav_volume_up">音量加</string>
    <string name="nav_up">方向键上</string>
    <string name="nav_down">方向键下</string>
    <string name="nav_left">方向键左</string>
    <string name="nav_right">方向键右</string>
    <string name="nav_center">方向键中心</string>
    <string name="nav_trackball">轨迹球</string>
    <string name="nav_trackball_sub">在导航栏上方的圆圈上滑动即可滚动；点按即可选择。</string>
    <string name="nav_dpad_mode">方向键模式</string>
    <string name="nav_dpad_sub">关闭：为客户机应用提供真实的相对轨迹球事件。开启：改为发送方向键按键。不会同时发送两者。</string>
    <string name="nav_sensitivity">灵敏度：每步 %1$d dp（数值越小越快）</string>
    <string name="nav_trackball_waiting">尚未连接客户机轨迹球</string>
    <string name="nav_trackball_recovery">Recovery：请使用方向键模式</string>
    <string name="nav_go_to_recovery">进入 recovery</string>
    <string name="vs_bluetooth">主机蓝牙(实验性)</string>
    <string name="vs_bluetooth_sub">允许客户机通过手机扫描蓝牙设备、列出已配对设备并与之通信:经典串口(RFCOMM)和低功耗蓝牙(GATT)。需要蓝牙权限并完全重启虚拟机。不是原始 HCI:客户机通过桥接看到手机的适配器,因此不支持耳机(音频配置文件)。</string>
    <string name="bluetooth_permission_denied">蓝牙权限被拒绝:客户机将在没有主机蓝牙的情况下启动。</string>
    <string name="vs_sf_tombstone">SurfaceFlinger 崩溃墓碑（调试）</string>
    <string name="vs_sf_tombstone_sub">SurfaceFlinger 崩溃时，让固件向日志写入普通墓碑（包含崩溃的函数），而不是简短报告。提交错误报告时请使用。下次完整启动虚拟机时生效。</string>
    <string name="vi_mouse_keyboard">输入:鼠标和键盘</string>
    <string name="vi_mouse_keyboard_sub">在客户机中注册触控板和键盘,并移除其触摸屏。屏幕将变为触控板(轻点点击,双指滚动),导航栏中会出现键盘按钮。需要 QEMU 引擎(非原生 64 位引擎)并完全重启虚拟机。</string>
    <string name="vi_keypad">输入:小键盘</string>
    <string name="vi_keypad_sub">在导航栏中添加小键盘按钮:方向键、确认键、软键、通话/挂断,以及类似功能手机的 0–9 * #。触控仍可使用,并可与鼠标和键盘组合使用。</string>
    <string name="vi_keyboard">键盘</string>
    <string name="vi_keypad_title">小键盘</string>
    <string name="vi_close">关闭</string>
    <string name="vi_open_keyboard">键盘</string>
    <string name="vi_open_keypad">小键盘</string>
    <string name="m_resize_screen">调整屏幕大小</string>
    <string name="m_resize_done">完成调整</string>
    <string name="m_resize_reset">重置屏幕大小</string>
    <string name="vi_resize_hint">拖动屏幕的一角来调整大小。完成后打开菜单并点按“完成调整”。</string>
