<resources>
    <string name="vs_hide_menu">隱藏選單按鈕</string>
    <string name="vs_hide_menu_sub">隱藏 … 按鈕。手機的返回鍵或返回手勢會開啟模擬器選單，而不是將返回傳送給 Android。客體的導覽按鈕仍可控制 Android。</string>
    <string name="vs_vibration">客體震動</string>
    <string name="vs_vibration_sub">將舊版客體的震動轉送至手機。下次開機時生效；每次震動上限為 60 秒。</string>
    <string name="nav_buttons">導覽按鈕</string>
    <string name="nav_order">按鈕順序（由左至右）</string>
    <string name="nav_earlier">往前</string>
    <string name="nav_later">往後</string>
    <string name="nav_reset">重設按鈕</string>
    <string name="nav_search">搜尋</string>
    <string name="nav_power">電源</string>
    <string name="nav_go_to_recovery">前往 Recovery</string>
    <string name="nav_volume_down">音量減</string>
    <string name="nav_volume_up">音量加</string>
    <string name="nav_up">方向鍵 上</string>
    <string name="nav_down">方向鍵 下</string>
    <string name="nav_left">方向鍵 左</string>
    <string name="nav_right">方向鍵 右</string>
    <string name="nav_center">方向鍵 中央</string>
    <string name="nav_trackball">軌跡球</string>
    <string name="nav_trackball_sub">在導覽列上方的圓圈上滑動即可滾動；點一下即可選取。</string>
    <string name="nav_dpad_mode">方向鍵模式</string>
    <string name="nav_dpad_sub">關閉：向客體應用程式傳送真實的相對軌跡球事件。開啟：改為傳送方向鍵按下事件。不會同時傳送兩者。</string>
    <string name="nav_sensitivity">靈敏度：每步 %1$d dp（數值越低越快）</string>
    <string name="nav_trackball_waiting">尚無客體軌跡球連線</string>
    <string name="nav_trackball_recovery">Recovery：請使用方向鍵模式</string>
    <string name="vs_bluetooth">主機藍牙（實驗性）</string>
    <string name="vs_bluetooth_sub">讓客體透過手機掃描藍牙裝置、列出配對裝置並與其通訊：傳統序列埠（RFCOMM）與低功耗藍牙（GATT）。需要藍牙權限並完整重新啟動虛擬機器。這不是原始 HCI：客體是透過橋接看到手機的藍牙介面卡，因此不支援耳機（音訊設定檔）。</string>
    <string name="bluetooth_permission_denied">藍牙權限遭拒：客體將在沒有主機藍牙的情況下開機。</string>
    <string name="vs_sf_tombstone">SurfaceFlinger 當機墓碑（除錯）</string>
    <string name="vs_sf_tombstone_sub">SurfaceFlinger 當機時，讓韌體將一般墓碑（含當機的函式）寫入記錄，而非簡短報告。提交錯誤報告時請使用。下次完整啟動虛擬機器時生效。</string>
    <string name="vi_mouse_keyboard">輸入:滑鼠和鍵盤</string>
    <string name="vi_mouse_keyboard_sub">在客體中註冊觸控板和鍵盤,並移除其觸控螢幕。螢幕會變成觸控板(輕觸點選,雙指捲動),導覽列中會出現鍵盤按鈕。需要 QEMU 引擎(非原生 64 位元引擎)並完全重新啟動虛擬機器。</string>
    <string name="vi_keypad">輸入:小鍵盤</string>
    <string name="vi_keypad_sub">在導覽列中新增小鍵盤按鈕:方向鍵、確認鍵、軟鍵、通話/結束,以及類似功能型手機的 0–9 * #。觸控仍可使用,並可與滑鼠和鍵盤搭配使用。</string>
    <string name="vi_keyboard">鍵盤</string>
    <string name="vi_keypad_title">小鍵盤</string>
    <string name="vi_close">關閉</string>
    <string name="vi_open_keyboard">鍵盤</string>
    <string name="vi_open_keypad">小鍵盤</string>
    <string name="m_resize_screen">調整螢幕大小</string>
    <string name="m_resize_done">完成調整</string>
    <string name="m_resize_reset">重設螢幕大小</string>
    <string name="vi_resize_hint">拖曳螢幕的一角來調整大小。完成後開啟選單並輕觸「完成調整」。</string>
</resources>
